{
  "opencollection": "1.0.0",
  "info": {
    "name": "OpenMetadata APIs Agent Executions Audit Logs API",
    "version": "1.13"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Audit Logs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Export audit log events as JSON (async)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v1/audit/logs/export",
            "params": [
              {
                "name": "startTs",
                "value": "",
                "type": "query",
                "description": "Start timestamp in milliseconds (required)"
              },
              {
                "name": "endTs",
                "value": "",
                "type": "query",
                "description": "End timestamp in milliseconds (required)"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of records to export (default 10000, max 100000)"
              },
              {
                "name": "userName",
                "value": "",
                "type": "query",
                "description": "Filter by username"
              },
              {
                "name": "actorType",
                "value": "",
                "type": "query",
                "description": "Filter by actor type (USER, BOT, AGENT)"
              },
              {
                "name": "serviceName",
                "value": "",
                "type": "query",
                "description": "Filter by service name"
              },
              {
                "name": "entityType",
                "value": "",
                "type": "query",
                "description": "Filter by entity type"
              },
              {
                "name": "eventType",
                "value": "",
                "type": "query",
                "description": "Filter by event type"
              },
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "Search term to filter audit logs (searches across user_name, entity_fqn, service_name, entity_type)"
              }
            ]
          },
          "docs": "Initiates an asynchronous export of audit log events. Returns a job ID immediately. When the export is complete, the data will be sent via WebSocket on the csvExportChannel."
        },
        {
          "info": {
            "name": "List audit log events",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v1/audit/logs",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Limit the number of results returned. (1 to 200)"
              },
              {
                "name": "after",
                "value": "",
                "type": "query",
                "description": "Returns results after this cursor (for forward pagination)"
              },
              {
                "name": "before",
                "value": "",
                "type": "query",
                "description": "Returns results before this cursor (for backward pagination)"
              },
              {
                "name": "userName",
                "value": "",
                "type": "query",
                "description": "Filter by username"
              },
              {
                "name": "actorType",
                "value": "",
                "type": "query",
                "description": "Filter by actor type (USER, BOT, AGENT)"
              },
              {
                "name": "serviceName",
                "value": "",
                "type": "query",
                "description": "Filter by service name"
              },
              {
                "name": "entityType",
                "value": "",
                "type": "query",
                "description": "Filter by entity type"
              },
              {
                "name": "entityFQN",
                "value": "",
                "type": "query",
                "description": "Filter by entity fully qualified name"
              },
              {
                "name": "eventType",
                "value": "",
                "type": "query",
                "description": "Filter by event type"
              },
              {
                "name": "startTs",
                "value": "",
                "type": "query",
                "description": "Filter events after this timestamp (ms)"
              },
              {
                "name": "endTs",
                "value": "",
                "type": "query",
                "description": "Filter events before this timestamp (ms)"
              },
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "Search term to filter audit logs (searches across user_name, entity_fqn, service_name, entity_type)"
              }
            ]
          },
          "docs": "List audit log events"
        }
      ]
    }
  ],
  "bundled": true
}