      },
      "items": [
        {
          "info": {
            "name": "getOpenApiYaml",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/swagger.yaml"
          }
        }
      ]
    }
  ],
  "bundled": true
}