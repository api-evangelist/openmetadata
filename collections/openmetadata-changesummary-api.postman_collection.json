      "id": "cbe1f240-6b5d-4fe5-ba1f-333f6e9d6e55",
      "name": "ChangeSummary",
      "description": {
        "content": "APIs to retrieve change summary metadata for entities. Change summary tracks who changed each field, the source of the change (e.g., Suggested for AI-generated, Manual for user edits), and when the change occurred.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "c6046e98-68f7-416f-985c-2179288b3984",
          "name": "Get change summary for an entity by fully qualified name",
          "request": {
            "name": "Get change summary for an entity by fully qualified name",
            "description": {
              "content": "Returns the change summary map for the specified entity identified by its fully qualified name (FQN). Use fieldPrefix to filter entries (e.g., 'columns.' for column-level changes only).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "changeSummary",
                ":entityType",
                "name",
                ":fqn"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "fieldPrefix",
                  "value": "<string>",
                  "description": "Filter entries by field name prefix (e.g., 'columns.' to get only column-level changes)"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "10",
                  "description": "Limit the number of entries returned (1-1000)"
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Offset for pagination"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "entityType",
                  "description": "(Required) Entity type (e.g., table, topic, dashboard)"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "fqn",
                  "description": "(Required) Fully qualified name of the entity"
                }
              ]
            },
            "method": "GET",
