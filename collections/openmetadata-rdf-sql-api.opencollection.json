                "description": "Result format"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Translates SQL to SPARQL and executes against RDF store"
        },
        {
          "info": {
            "name": "Translate SQL to SPARQL",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/api/v1/rdf/sql/translate",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Translates SQL query to SPARQL without executing"
        }
      ]
    }
  ],
  "bundled": true
