        {
          "id": "137e7b49-f555-44fc-8ae6-4bc9cfc12b61",
          "name": "Get aggregate MCP usage counters",
          "request": {
            "name": "Get aggregate MCP usage counters",
            "description": {
              "content": "Returns total/success/failed counts and unique-user count for the supplied window. Defaults to the last 30 days. Admin access required.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "mcp",
                "usage",
                "summary"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "startTs",
                  "value": "<long>",
                  "description": "Window start (epoch millis). Defaults to 30 days ago."
                },
                {
                  "disabled": false,
                  "key": "endTs",
                  "value": "<long>",
                  "description": "Window end exclusive (epoch millis). Defaults to now."
                }
              ],
              "variable": []
            },
